{
  "name": "react-native-amwal-ecr",
  "version": "0.1.0",
  "description": "React Native bridge for the Amwal ECR SDK on Android and iOS.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-amwal-ecr-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-amwal-ecr-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "verify": "yarn lint && yarn typecheck && yarn test:ci && yarn prepare && npm pack --dry-run"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ecr",
    "pos",
    "payments",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amwal-pay/amwal-ecr-rn.git"
  },
  "author": "Amwal Pay <support@amwal-pay.com> (https://amwal-pay.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amwal-pay/amwal-ecr-rn/issues"
  },
  "homepage": "https://github.com/amwal-pay/amwal-ecr-rn#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.2.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AmwalEcrSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.amwalecr"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "watchman": false,
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/NativeAmwalEcr.ts",
      "!src/**/*.native.ts"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
